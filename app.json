{
  "expo": {
    "name": "HalfLifeControl",
    "slug": "halflifecontrol",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "halflifecontrol",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#004d64"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.halflifecontrol.app"
    },
    "android": {
      "package": "com.halflifecontrol.app",
      "adaptiveIcon": {
        "backgroundColor": "#004d64",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./src/app"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Lexend-Regular.ttf",
            "./assets/fonts/Lexend-Light.ttf",
            "./assets/fonts/Lexend-Medium.ttf",
            "./assets/fonts/Lexend-SemiBold.ttf",
            "./assets/fonts/Lexend-Bold.ttf",
            "./assets/fonts/PlusJakartaSans-Regular.ttf",
            "./assets/fonts/PlusJakartaSans-Light.ttf",
            "./assets/fonts/PlusJakartaSans-Medium.ttf",
            "./assets/fonts/PlusJakartaSans-SemiBold.ttf",
            "./assets/fonts/PlusJakartaSans-Bold.ttf"
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#004d64"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "SENTRY_ORG",
          "project": "SENTRY_PROJECT"
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "router": {
        "root": "./src/app"
      },
      "eas": {
        "projectId": "31bab4d6-d49d-4592-b1e6-f26a8a285f64"
      }
    }
  }
}
