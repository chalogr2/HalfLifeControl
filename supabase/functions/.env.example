# Edge Function secrets — set with `supabase secrets set KEY=value` after
# `supabase login` and `supabase link --project-ref <ref>`. These are
# injected into every function's process.env at invocation time.
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically by
# Supabase -- you do NOT need to set them manually. They appear here only
# for documentation.

# Auto-injected by Supabase (do not set):
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<the service_role key from Project Settings > API>

# Must be set:
# Shared secret between Supabase and RevenueCat. Generate any opaque random
# string (e.g. `openssl rand -hex 32`). Configure the same value as the
# Authorization header in RevenueCat dashboard > Integrations > Webhooks.
REVENUECAT_WEBHOOK_AUTH=
